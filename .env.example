# Public NSEInvest environment URL. Keep UAT until NSE approves production.
NSEINVEST_BASE_URL=https://nseinvestuat.nseindia.com

# Store these only in Vercel Environment Variables. Never commit real values.
NSEINVEST_LOGIN_USER_ID=
NSEINVEST_API_KEY_MEMBER=
NSEINVEST_API_SECRET_USER=
NSEINVEST_MEMBER_CODE=

# Create a separate random value of at least 32 characters for dashboard access.
RNK_NSE_ADMIN_TOKEN=

# Optional connection settings.
NSEINVEST_USER_AGENT=PostmanRuntime/7.43.4
NSEINVEST_TIMEOUT_MS=20000

